#!/bin/bash
#SBATCH --partition=p_fast
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1gb
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=al

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID
mkdir $scr

cd $scr

cp /gscratch/povmieci/TMP/al.2645107/al.inp $scr/.
cp /gscratch/povmieci/TMP/al.2645107/*bas $scr/.
if [ -f /gscratch/povmieci/TMP/al.2645107/al.gcf ]; then
echo " cp /gscratch/povmieci/TMP/al.2645107/al.gcf  $scr/."
cp /gscratch/povmieci/TMP/al.2645107/al.gcf  $scr/GCF
fi

#module load intel/2020a
#module load intel/2020a #  intel/2019b
module load foss/2023b
if [ 12 -gt "1" ]; then
echo "Running Parallel DoNOF"
# module load impi
mpirun  /software/users/povpisim/DoNOFmpig.x < al.inp > al.out
#srun  /software/users/povpisim/DoNOFmpi.x < al.inp > al.out
else
echo "Running Serial DoNOF"
# module load intel
/software/users/povpisim/DoNOF.x < al.inp > al.out
fi

#out="/gscratch/povmieci/TMP/al.2645107/al"."${SLURM_JOBID}"
#mkdir $out
out="/gscratch/povmieci/TMP/al.2645107"
ls $out

 mv -f al.inp $out/.
 mv -f al.out $out/.
 mv -f GCF        $out/al.gcf
 mv -f GCFe       $out/al.gcfe
 mv -f WFN        $out/al.wfn
 mv -f CGGRAD     $out/al.cgo
 mv -f FCHK       $out/al.fchk
 mv -f 1DM        $out/al.1dm
 cat MLD XYZ >    $out/al.mld
 
 ls
 cd $out
 
 cp -f al.gcf  $SLURM_SUBMIT_DIR/.
 cp -f al.gcfe $SLURM_SUBMIT_DIR/.
 cp -f al.wfn  $SLURM_SUBMIT_DIR/.
 cp -f al.cgo  $SLURM_SUBMIT_DIR/.
 cp -f al.fchk $SLURM_SUBMIT_DIR/.
 cp -f al.mld  $SLURM_SUBMIT_DIR/.
 cp -f al.1dm  $SLURM_SUBMIT_DIR/.
       
 zip al-out.zip al.out
 mv -f al-out.zip $SLURM_SUBMIT_DIR/.
 
 rm -rf $scr

