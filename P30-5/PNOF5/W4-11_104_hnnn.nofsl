#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=8gb
#SBATCH --time=96:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=W4-11_104_hnnn

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/W4-11_104_hnnn.1016757/W4-11_104_hnnn.inp $scr/.
cp /gscratch/povmieci/TMP/W4-11_104_hnnn.1016757/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/W4-11_104_hnnn.1016757/W4-11_104_hnnn.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/W4-11_104_hnnn.1016757/W4-11_104_hnnn.gcf  $scr/."
cp /gscratch/povmieci/TMP/W4-11_104_hnnn.1016757/W4-11_104_hnnn.gcf  $scr/GCF
fi

module load foss/2023b

if [ 12 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < W4-11_104_hnnn.inp > W4-11_104_hnnn.out
	srun  /software/users/povpisim/DoNOFmpig.x < W4-11_104_hnnn.inp > W4-11_104_hnnn.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < W4-11_104_hnnn.inp > W4-11_104_hnnn.out
fi

out="/gscratch/povmieci/TMP/W4-11_104_hnnn.1016757"

ls $out

 zip W4-11_104_hnnn-out.zip W4-11_104_hnnn.out

 mv -f W4-11_104_hnnn.inp     $out/.
 mv -f W4-11_104_hnnn-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/W4-11_104_hnnn.gcf
 mv -f GCFe           $out/W4-11_104_hnnn.gcfe
 mv -f WFN            $out/W4-11_104_hnnn.wfn
 mv -f CGGRAD         $out/W4-11_104_hnnn.cgo
 mv -f FCHK           $out/W4-11_104_hnnn.fchk
 mv -f 1DM            $out/W4-11_104_hnnn.1dm
 cat MLD XYZ >        $out/W4-11_104_hnnn.mld

 rm -f BFST CGM W4-11_104_hnnn.out

 ls 

 cd $out
 
###  cp -f W4-11_104_hnnn.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_104_hnnn.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_104_hnnn.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_104_hnnn.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_104_hnnn.fchk $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_104_hnnn.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_104_hnnn.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

