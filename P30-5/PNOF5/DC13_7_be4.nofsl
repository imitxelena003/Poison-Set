#!/bin/bash
#SBATCH --partition=p_fast
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1gb
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j

## Do not change below this line
####SBATCH --mem=7520mb

JOBNAME=DC13_7_be4

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID
mkdir $scr

cd $scr

cp /gscratch/povmieci/TMP/DC13_7_be4.1500828/DC13_7_be4.inp $scr/.
cp /gscratch/povmieci/TMP/DC13_7_be4.1500828/*bas $scr/.
if [ -f /gscratch/povmieci/TMP/DC13_7_be4.1500828/DC13_7_be4.gcf ]; then
echo " cp /gscratch/povmieci/TMP/DC13_7_be4.1500828/DC13_7_be4.gcf  $scr/."
cp /gscratch/povmieci/TMP/DC13_7_be4.1500828/DC13_7_be4.gcf  $scr/GCF
fi

#module load intel/2020a
#module load intel/2020a #  intel/2019b
module load foss/2023b
if [ 8 -gt "1" ]; then
echo "Running Parallel DoNOF"
# module load impi
mpirun  /software/users/povpisim/DoNOFmpig.x < DC13_7_be4.inp > DC13_7_be4.out
#srun  /software/users/povpisim/DoNOFmpi.x < DC13_7_be4.inp > DC13_7_be4.out
else
echo "Running Serial DoNOF"
# module load intel
/software/users/povpisim/DoNOF.x < DC13_7_be4.inp > DC13_7_be4.out
fi

#out="/gscratch/povmieci/TMP/DC13_7_be4.1500828/DC13_7_be4"."${SLURM_JOBID}"
#mkdir $out
out="/gscratch/povmieci/TMP/DC13_7_be4.1500828"
ls $out

 mv -f DC13_7_be4.inp $out/.
 mv -f DC13_7_be4.out $out/.
 mv -f GCF        $out/DC13_7_be4.gcf
 mv -f GCFe       $out/DC13_7_be4.gcfe
 mv -f WFN        $out/DC13_7_be4.wfn
 mv -f CGGRAD     $out/DC13_7_be4.cgo
 mv -f FCHK       $out/DC13_7_be4.fchk
 mv -f 1DM        $out/DC13_7_be4.1dm
 cat MLD XYZ >    $out/DC13_7_be4.mld
 
 ls
 cd $out
 
 cp -f DC13_7_be4.gcf  $SLURM_SUBMIT_DIR/.
 cp -f DC13_7_be4.gcfe $SLURM_SUBMIT_DIR/.
 cp -f DC13_7_be4.wfn  $SLURM_SUBMIT_DIR/.
 cp -f DC13_7_be4.cgo  $SLURM_SUBMIT_DIR/.
 cp -f DC13_7_be4.fchk $SLURM_SUBMIT_DIR/.
 cp -f DC13_7_be4.mld  $SLURM_SUBMIT_DIR/.
 cp -f DC13_7_be4.1dm  $SLURM_SUBMIT_DIR/.
       
 zip DC13_7_be4-out.zip DC13_7_be4.out
 mv -f DC13_7_be4-out.zip $SLURM_SUBMIT_DIR/.
 
 rm -rf $scr

