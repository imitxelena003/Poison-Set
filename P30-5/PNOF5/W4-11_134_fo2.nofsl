#!/bin/bash
#SBATCH --partition=p_fast
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1gb
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j

## Do not change below this line
####SBATCH --mem=7520mb

JOBNAME=W4-11_134_fo2

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID
mkdir $scr

cd $scr

cp /gscratch/povmieci/TMP/W4-11_134_fo2.1609314/W4-11_134_fo2.inp $scr/.
cp /gscratch/povmieci/TMP/W4-11_134_fo2.1609314/*bas $scr/.
if [ -f /gscratch/povmieci/TMP/W4-11_134_fo2.1609314/W4-11_134_fo2.gcf ]; then
echo " cp /gscratch/povmieci/TMP/W4-11_134_fo2.1609314/W4-11_134_fo2.gcf  $scr/."
cp /gscratch/povmieci/TMP/W4-11_134_fo2.1609314/W4-11_134_fo2.gcf  $scr/GCF
fi

#module load intel/2020a
#module load intel/2020a #  intel/2019b
module load foss/2023b
if [ 8 -gt "1" ]; then
echo "Running Parallel DoNOF"
# module load impi
mpirun  /software/users/povpisim/DoNOFmpig.x < W4-11_134_fo2.inp > W4-11_134_fo2.out
#srun  /software/users/povpisim/DoNOFmpi.x < W4-11_134_fo2.inp > W4-11_134_fo2.out
else
echo "Running Serial DoNOF"
# module load intel
/software/users/povpisim/DoNOF.x < W4-11_134_fo2.inp > W4-11_134_fo2.out
fi

#out="/gscratch/povmieci/TMP/W4-11_134_fo2.1609314/W4-11_134_fo2"."${SLURM_JOBID}"
#mkdir $out
out="/gscratch/povmieci/TMP/W4-11_134_fo2.1609314"
ls $out

 mv -f W4-11_134_fo2.inp $out/.
 mv -f W4-11_134_fo2.out $out/.
 mv -f GCF        $out/W4-11_134_fo2.gcf
 mv -f GCFe       $out/W4-11_134_fo2.gcfe
 mv -f WFN        $out/W4-11_134_fo2.wfn
 mv -f CGGRAD     $out/W4-11_134_fo2.cgo
 mv -f FCHK       $out/W4-11_134_fo2.fchk
 mv -f 1DM        $out/W4-11_134_fo2.1dm
 cat MLD XYZ >    $out/W4-11_134_fo2.mld
 
 ls
 cd $out
 
 cp -f W4-11_134_fo2.gcf  $SLURM_SUBMIT_DIR/.
 cp -f W4-11_134_fo2.gcfe $SLURM_SUBMIT_DIR/.
 cp -f W4-11_134_fo2.wfn  $SLURM_SUBMIT_DIR/.
 cp -f W4-11_134_fo2.cgo  $SLURM_SUBMIT_DIR/.
 cp -f W4-11_134_fo2.fchk $SLURM_SUBMIT_DIR/.
 cp -f W4-11_134_fo2.mld  $SLURM_SUBMIT_DIR/.
 cp -f W4-11_134_fo2.1dm  $SLURM_SUBMIT_DIR/.
       
 zip W4-11_134_fo2-out.zip W4-11_134_fo2.out
 mv -f W4-11_134_fo2-out.zip $SLURM_SUBMIT_DIR/.
 
 rm -rf $scr

