#!/bin/bash
#SBATCH --partition=p_fast
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1gb
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j

## Do not change below this line
####SBATCH --mem=7520mb

JOBNAME=SIE4x4_9_nh3+

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID
mkdir $scr

cd $scr

cp /gscratch/povmieci/TMP/SIE4x4_9_nh3+.1515284/SIE4x4_9_nh3+.inp $scr/.
cp /gscratch/povmieci/TMP/SIE4x4_9_nh3+.1515284/*bas $scr/.
if [ -f /gscratch/povmieci/TMP/SIE4x4_9_nh3+.1515284/SIE4x4_9_nh3+.gcf ]; then
echo " cp /gscratch/povmieci/TMP/SIE4x4_9_nh3+.1515284/SIE4x4_9_nh3+.gcf  $scr/."
cp /gscratch/povmieci/TMP/SIE4x4_9_nh3+.1515284/SIE4x4_9_nh3+.gcf  $scr/GCF
fi

#module load intel/2020a
#module load intel/2020a #  intel/2019b
module load foss/2023b
if [ 8 -gt "1" ]; then
echo "Running Parallel DoNOF"
# module load impi
mpirun  /software/users/povpisim/DoNOFmpig.x < SIE4x4_9_nh3+.inp > SIE4x4_9_nh3+.out
#srun  /software/users/povpisim/DoNOFmpi.x < SIE4x4_9_nh3+.inp > SIE4x4_9_nh3+.out
else
echo "Running Serial DoNOF"
# module load intel
/software/users/povpisim/DoNOF.x < SIE4x4_9_nh3+.inp > SIE4x4_9_nh3+.out
fi

#out="/gscratch/povmieci/TMP/SIE4x4_9_nh3+.1515284/SIE4x4_9_nh3+"."${SLURM_JOBID}"
#mkdir $out
out="/gscratch/povmieci/TMP/SIE4x4_9_nh3+.1515284"
ls $out

 mv -f SIE4x4_9_nh3+.inp $out/.
 mv -f SIE4x4_9_nh3+.out $out/.
 mv -f GCF        $out/SIE4x4_9_nh3+.gcf
 mv -f GCFe       $out/SIE4x4_9_nh3+.gcfe
 mv -f WFN        $out/SIE4x4_9_nh3+.wfn
 mv -f CGGRAD     $out/SIE4x4_9_nh3+.cgo
 mv -f FCHK       $out/SIE4x4_9_nh3+.fchk
 mv -f 1DM        $out/SIE4x4_9_nh3+.1dm
 cat MLD XYZ >    $out/SIE4x4_9_nh3+.mld
 
 ls
 cd $out
 
 cp -f SIE4x4_9_nh3+.gcf  $SLURM_SUBMIT_DIR/.
 cp -f SIE4x4_9_nh3+.gcfe $SLURM_SUBMIT_DIR/.
 cp -f SIE4x4_9_nh3+.wfn  $SLURM_SUBMIT_DIR/.
 cp -f SIE4x4_9_nh3+.cgo  $SLURM_SUBMIT_DIR/.
 cp -f SIE4x4_9_nh3+.fchk $SLURM_SUBMIT_DIR/.
 cp -f SIE4x4_9_nh3+.mld  $SLURM_SUBMIT_DIR/.
 cp -f SIE4x4_9_nh3+.1dm  $SLURM_SUBMIT_DIR/.
       
 zip SIE4x4_9_nh3+-out.zip SIE4x4_9_nh3+.out
 mv -f SIE4x4_9_nh3+-out.zip $SLURM_SUBMIT_DIR/.
 
 rm -rf $scr

