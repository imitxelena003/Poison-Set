#!/bin/bash
#SBATCH --partition=p_fast
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1gb
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=s

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID
mkdir $scr

cd $scr

cp /gscratch/povmieci/TMP/s.294226/s.inp $scr/.
cp /gscratch/povmieci/TMP/s.294226/*bas $scr/.
if [ -f /gscratch/povmieci/TMP/s.294226/s.gcf ]; then
echo " cp /gscratch/povmieci/TMP/s.294226/s.gcf  $scr/."
cp /gscratch/povmieci/TMP/s.294226/s.gcf  $scr/GCF
fi

#module load intel/2020a
#module load intel/2020a #  intel/2019b
module load foss/2023b
if [ 12 -gt "1" ]; then
echo "Running Parallel DoNOF"
# module load impi
mpirun  /software/users/povpisim/DoNOFmpig.x < s.inp > s.out
#srun  /software/users/povpisim/DoNOFmpi.x < s.inp > s.out
else
echo "Running Serial DoNOF"
# module load intel
/software/users/povpisim/DoNOF.x < s.inp > s.out
fi

#out="/gscratch/povmieci/TMP/s.294226/s"."${SLURM_JOBID}"
#mkdir $out
out="/gscratch/povmieci/TMP/s.294226"
ls $out

 mv -f s.inp $out/.
 mv -f s.out $out/.
 mv -f GCF        $out/s.gcf
 mv -f GCFe       $out/s.gcfe
 mv -f WFN        $out/s.wfn
 mv -f CGGRAD     $out/s.cgo
 mv -f FCHK       $out/s.fchk
 mv -f 1DM        $out/s.1dm
 cat MLD XYZ >    $out/s.mld
 
 ls
 cd $out
 
 cp -f s.gcf  $SLURM_SUBMIT_DIR/.
 cp -f s.gcfe $SLURM_SUBMIT_DIR/.
 cp -f s.wfn  $SLURM_SUBMIT_DIR/.
 cp -f s.cgo  $SLURM_SUBMIT_DIR/.
 cp -f s.fchk $SLURM_SUBMIT_DIR/.
 cp -f s.mld  $SLURM_SUBMIT_DIR/.
 cp -f s.1dm  $SLURM_SUBMIT_DIR/.
       
 zip s-out.zip s.out
 mv -f s-out.zip $SLURM_SUBMIT_DIR/.
 
 rm -rf $scr

