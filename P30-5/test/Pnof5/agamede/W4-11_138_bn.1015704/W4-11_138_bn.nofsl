#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=6gb
#SBATCH --time=96:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=W4-11_138_bn

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/W4-11_138_bn.1015704/W4-11_138_bn.inp $scr/.
cp /gscratch/povmieci/TMP/W4-11_138_bn.1015704/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/W4-11_138_bn.1015704/W4-11_138_bn.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/W4-11_138_bn.1015704/W4-11_138_bn.gcf  $scr/."
cp /gscratch/povmieci/TMP/W4-11_138_bn.1015704/W4-11_138_bn.gcf  $scr/GCF
fi

module load foss/2023b

if [ 12 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < W4-11_138_bn.inp > W4-11_138_bn.out
	srun  /software/users/povpisim/DoNOFmpig.x < W4-11_138_bn.inp > W4-11_138_bn.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < W4-11_138_bn.inp > W4-11_138_bn.out
fi

out="/gscratch/povmieci/TMP/W4-11_138_bn.1015704"

ls $out

 zip W4-11_138_bn-out.zip W4-11_138_bn.out

 mv -f W4-11_138_bn.inp     $out/.
 mv -f W4-11_138_bn-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/W4-11_138_bn.gcf
 mv -f GCFe           $out/W4-11_138_bn.gcfe
 mv -f WFN            $out/W4-11_138_bn.wfn
 mv -f CGGRAD         $out/W4-11_138_bn.cgo
 mv -f FCHK           $out/W4-11_138_bn.fchk
 mv -f 1DM            $out/W4-11_138_bn.1dm
 cat MLD XYZ >        $out/W4-11_138_bn.mld

 rm -f BFST CGM W4-11_138_bn.out

 ls 

 cd $out
 
###  cp -f W4-11_138_bn.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_138_bn.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_138_bn.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_138_bn.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_138_bn.fchk $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_138_bn.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_138_bn.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

