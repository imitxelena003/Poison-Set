#!/bin/bash
#SBATCH --partition=p_fast
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1gb
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j

## Do not change below this line
####SBATCH --mem=7520mb

JOBNAME=ALKBDE10_2_cao

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID
mkdir $scr

cd $scr

cp /gscratch/povmieci/TMP/ALKBDE10_2_cao.1500654/ALKBDE10_2_cao.inp $scr/.
cp /gscratch/povmieci/TMP/ALKBDE10_2_cao.1500654/*bas $scr/.
if [ -f /gscratch/povmieci/TMP/ALKBDE10_2_cao.1500654/ALKBDE10_2_cao.gcf ]; then
echo " cp /gscratch/povmieci/TMP/ALKBDE10_2_cao.1500654/ALKBDE10_2_cao.gcf  $scr/."
cp /gscratch/povmieci/TMP/ALKBDE10_2_cao.1500654/ALKBDE10_2_cao.gcf  $scr/GCF
fi

#module load intel/2020a
#module load intel/2020a #  intel/2019b
module load foss/2023b
if [ 8 -gt "1" ]; then
echo "Running Parallel DoNOF"
# module load impi
mpirun  /software/users/povpisim/DoNOFmpig.x < ALKBDE10_2_cao.inp > ALKBDE10_2_cao.out
#srun  /software/users/povpisim/DoNOFmpi.x < ALKBDE10_2_cao.inp > ALKBDE10_2_cao.out
else
echo "Running Serial DoNOF"
# module load intel
/software/users/povpisim/DoNOF.x < ALKBDE10_2_cao.inp > ALKBDE10_2_cao.out
fi

#out="/gscratch/povmieci/TMP/ALKBDE10_2_cao.1500654/ALKBDE10_2_cao"."${SLURM_JOBID}"
#mkdir $out
out="/gscratch/povmieci/TMP/ALKBDE10_2_cao.1500654"
ls $out

 mv -f ALKBDE10_2_cao.inp $out/.
 mv -f ALKBDE10_2_cao.out $out/.
 mv -f GCF        $out/ALKBDE10_2_cao.gcf
 mv -f GCFe       $out/ALKBDE10_2_cao.gcfe
 mv -f WFN        $out/ALKBDE10_2_cao.wfn
 mv -f CGGRAD     $out/ALKBDE10_2_cao.cgo
 mv -f FCHK       $out/ALKBDE10_2_cao.fchk
 mv -f 1DM        $out/ALKBDE10_2_cao.1dm
 cat MLD XYZ >    $out/ALKBDE10_2_cao.mld
 
 ls
 cd $out
 
 cp -f ALKBDE10_2_cao.gcf  $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_2_cao.gcfe $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_2_cao.wfn  $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_2_cao.cgo  $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_2_cao.fchk $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_2_cao.mld  $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_2_cao.1dm  $SLURM_SUBMIT_DIR/.
       
 zip ALKBDE10_2_cao-out.zip ALKBDE10_2_cao.out
 mv -f ALKBDE10_2_cao-out.zip $SLURM_SUBMIT_DIR/.
 
 rm -rf $scr

