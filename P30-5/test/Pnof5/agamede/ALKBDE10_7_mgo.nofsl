#!/bin/bash
#SBATCH --partition=p_fast
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1gb
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j

## Do not change below this line
####SBATCH --mem=7520mb

JOBNAME=ALKBDE10_7_mgo

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID
mkdir $scr

cd $scr

cp /gscratch/povmieci/TMP/ALKBDE10_7_mgo.1500733/ALKBDE10_7_mgo.inp $scr/.
cp /gscratch/povmieci/TMP/ALKBDE10_7_mgo.1500733/*bas $scr/.
if [ -f /gscratch/povmieci/TMP/ALKBDE10_7_mgo.1500733/ALKBDE10_7_mgo.gcf ]; then
echo " cp /gscratch/povmieci/TMP/ALKBDE10_7_mgo.1500733/ALKBDE10_7_mgo.gcf  $scr/."
cp /gscratch/povmieci/TMP/ALKBDE10_7_mgo.1500733/ALKBDE10_7_mgo.gcf  $scr/GCF
fi

#module load intel/2020a
#module load intel/2020a #  intel/2019b
module load foss/2023b
if [ 8 -gt "1" ]; then
echo "Running Parallel DoNOF"
# module load impi
mpirun  /software/users/povpisim/DoNOFmpig.x < ALKBDE10_7_mgo.inp > ALKBDE10_7_mgo.out
#srun  /software/users/povpisim/DoNOFmpi.x < ALKBDE10_7_mgo.inp > ALKBDE10_7_mgo.out
else
echo "Running Serial DoNOF"
# module load intel
/software/users/povpisim/DoNOF.x < ALKBDE10_7_mgo.inp > ALKBDE10_7_mgo.out
fi

#out="/gscratch/povmieci/TMP/ALKBDE10_7_mgo.1500733/ALKBDE10_7_mgo"."${SLURM_JOBID}"
#mkdir $out
out="/gscratch/povmieci/TMP/ALKBDE10_7_mgo.1500733"
ls $out

 mv -f ALKBDE10_7_mgo.inp $out/.
 mv -f ALKBDE10_7_mgo.out $out/.
 mv -f GCF        $out/ALKBDE10_7_mgo.gcf
 mv -f GCFe       $out/ALKBDE10_7_mgo.gcfe
 mv -f WFN        $out/ALKBDE10_7_mgo.wfn
 mv -f CGGRAD     $out/ALKBDE10_7_mgo.cgo
 mv -f FCHK       $out/ALKBDE10_7_mgo.fchk
 mv -f 1DM        $out/ALKBDE10_7_mgo.1dm
 cat MLD XYZ >    $out/ALKBDE10_7_mgo.mld
 
 ls
 cd $out
 
 cp -f ALKBDE10_7_mgo.gcf  $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_7_mgo.gcfe $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_7_mgo.wfn  $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_7_mgo.cgo  $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_7_mgo.fchk $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_7_mgo.mld  $SLURM_SUBMIT_DIR/.
 cp -f ALKBDE10_7_mgo.1dm  $SLURM_SUBMIT_DIR/.
       
 zip ALKBDE10_7_mgo-out.zip ALKBDE10_7_mgo.out
 mv -f ALKBDE10_7_mgo-out.zip $SLURM_SUBMIT_DIR/.
 
 rm -rf $scr

