#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=12gb
#SBATCH --time=96:00:00
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=45120mb

JOBNAME=G2RC_10_67

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/G2RC_10_67.3011485/G2RC_10_67.inp $scr/.
cp /gscratch/povmieci/TMP/G2RC_10_67.3011485/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/G2RC_10_67.3011485/G2RC_10_67.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/G2RC_10_67.3011485/G2RC_10_67.gcf  $scr/."
cp /gscratch/povmieci/TMP/G2RC_10_67.3011485/G2RC_10_67.gcf  $scr/GCF
fi

module load foss/2023b

if [ 48 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < G2RC_10_67.inp > G2RC_10_67.out
	srun  /software/users/povpisim/DoNOFmpig.x < G2RC_10_67.inp > G2RC_10_67.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < G2RC_10_67.inp > G2RC_10_67.out
fi

out="/gscratch/povmieci/TMP/G2RC_10_67.3011485"

ls $out

 zip G2RC_10_67-out.zip G2RC_10_67.out

 mv -f G2RC_10_67.inp     $out/.
 mv -f G2RC_10_67-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/G2RC_10_67.gcf
 mv -f GCFe           $out/G2RC_10_67.gcfe
 mv -f WFN            $out/G2RC_10_67.wfn
 mv -f CGGRAD         $out/G2RC_10_67.cgo
 mv -f FCHK           $out/G2RC_10_67.fchk
 mv -f 1DM            $out/G2RC_10_67.1dm
 cat MLD XYZ >        $out/G2RC_10_67.mld

 rm -f BFST CGM G2RC_10_67.out

 ls 

 cd $out
 
###  cp -f G2RC_10_67.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67.fchk $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

