#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=8gb
#SBATCH --time=120:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=W4-11_109_bn3pi

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/W4-11_109_bn3pi.1612215/W4-11_109_bn3pi.inp $scr/.
cp /gscratch/povmieci/TMP/W4-11_109_bn3pi.1612215/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/W4-11_109_bn3pi.1612215/W4-11_109_bn3pi.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/W4-11_109_bn3pi.1612215/W4-11_109_bn3pi.gcf  $scr/."
cp /gscratch/povmieci/TMP/W4-11_109_bn3pi.1612215/W4-11_109_bn3pi.gcf  $scr/GCF
fi

module load foss/2023b

if [ 12 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < W4-11_109_bn3pi.inp > W4-11_109_bn3pi.out
	srun  /software/users/povpisim/DoNOFmpig.x < W4-11_109_bn3pi.inp > W4-11_109_bn3pi.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < W4-11_109_bn3pi.inp > W4-11_109_bn3pi.out
fi

out="/gscratch/povmieci/TMP/W4-11_109_bn3pi.1612215"

ls $out

 zip W4-11_109_bn3pi-out.zip W4-11_109_bn3pi.out

 mv -f W4-11_109_bn3pi.inp     $out/.
 mv -f W4-11_109_bn3pi-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/W4-11_109_bn3pi.gcf
 mv -f GCFe           $out/W4-11_109_bn3pi.gcfe
 mv -f WFN            $out/W4-11_109_bn3pi.wfn
 mv -f CGGRAD         $out/W4-11_109_bn3pi.cgo
 mv -f FCHK           $out/W4-11_109_bn3pi.fchk
 mv -f 1DM            $out/W4-11_109_bn3pi.1dm
 cat MLD XYZ >        $out/W4-11_109_bn3pi.mld

 rm -f BFST CGM W4-11_109_bn3pi.out

 ls 

 cd $out
 
###  cp -f W4-11_109_bn3pi.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_109_bn3pi.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_109_bn3pi.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_109_bn3pi.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_109_bn3pi.fchk $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_109_bn3pi.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_109_bn3pi.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

