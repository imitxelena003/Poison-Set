#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=8gb
#SBATCH --time=96:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=G2RC_20_1

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/G2RC_20_1.3439547/G2RC_20_1.inp $scr/.
cp /gscratch/povmieci/TMP/G2RC_20_1.3439547/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/G2RC_20_1.3439547/G2RC_20_1.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/G2RC_20_1.3439547/G2RC_20_1.gcf  $scr/."
cp /gscratch/povmieci/TMP/G2RC_20_1.3439547/G2RC_20_1.gcf  $scr/GCF
fi

module load foss/2023b

if [ 12 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < G2RC_20_1.inp > G2RC_20_1.out
	srun  /software/users/povpisim/DoNOFmpig.x < G2RC_20_1.inp > G2RC_20_1.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < G2RC_20_1.inp > G2RC_20_1.out
fi

out="/gscratch/povmieci/TMP/G2RC_20_1.3439547"

ls $out

 zip G2RC_20_1-out.zip G2RC_20_1.out

 mv -f G2RC_20_1.inp     $out/.
 mv -f G2RC_20_1-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/G2RC_20_1.gcf
 mv -f GCFe           $out/G2RC_20_1.gcfe
 mv -f WFN            $out/G2RC_20_1.wfn
 mv -f CGGRAD         $out/G2RC_20_1.cgo
 mv -f FCHK           $out/G2RC_20_1.fchk
 mv -f 1DM            $out/G2RC_20_1.1dm
 cat MLD XYZ >        $out/G2RC_20_1.mld

 rm -f BFST CGM G2RC_20_1.out

 ls 

 cd $out
 
###  cp -f G2RC_20_1.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_20_1.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_20_1.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_20_1.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_20_1.fchk $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_20_1.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_20_1.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

