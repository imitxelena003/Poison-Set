#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=4gb
#SBATCH --time=96:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=BH76_9_hf2ts

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/BH76_9_hf2ts.3440252/BH76_9_hf2ts.inp $scr/.
cp /gscratch/povmieci/TMP/BH76_9_hf2ts.3440252/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/BH76_9_hf2ts.3440252/BH76_9_hf2ts.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/BH76_9_hf2ts.3440252/BH76_9_hf2ts.gcf  $scr/."
cp /gscratch/povmieci/TMP/BH76_9_hf2ts.3440252/BH76_9_hf2ts.gcf  $scr/GCF
fi

module load foss/2023b

if [ 12 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < BH76_9_hf2ts.inp > BH76_9_hf2ts.out
	srun  /software/users/povpisim/DoNOFmpig.x < BH76_9_hf2ts.inp > BH76_9_hf2ts.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < BH76_9_hf2ts.inp > BH76_9_hf2ts.out
fi

out="/gscratch/povmieci/TMP/BH76_9_hf2ts.3440252"

ls $out

 zip BH76_9_hf2ts-out.zip BH76_9_hf2ts.out

 mv -f BH76_9_hf2ts.inp     $out/.
 mv -f BH76_9_hf2ts-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/BH76_9_hf2ts.gcf
 mv -f GCFe           $out/BH76_9_hf2ts.gcfe
 mv -f WFN            $out/BH76_9_hf2ts.wfn
 mv -f CGGRAD         $out/BH76_9_hf2ts.cgo
 mv -f FCHK           $out/BH76_9_hf2ts.fchk
 mv -f 1DM            $out/BH76_9_hf2ts.1dm
 cat MLD XYZ >        $out/BH76_9_hf2ts.mld

 rm -f BFST CGM BH76_9_hf2ts.out

 ls 

 cd $out
 
###  cp -f BH76_9_hf2ts.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_9_hf2ts.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f BH76_9_hf2ts.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_9_hf2ts.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_9_hf2ts.fchk $SLURM_SUBMIT_DIR/.
###  cp -f BH76_9_hf2ts.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_9_hf2ts.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

