#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=6gb
#SBATCH --time=96:00:00
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=22560mb

JOBNAME=W4-11_113_n2o

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/W4-11_113_n2o.1613093/W4-11_113_n2o.inp $scr/.
cp /gscratch/povmieci/TMP/W4-11_113_n2o.1613093/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/W4-11_113_n2o.1613093/W4-11_113_n2o.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/W4-11_113_n2o.1613093/W4-11_113_n2o.gcf  $scr/."
cp /gscratch/povmieci/TMP/W4-11_113_n2o.1613093/W4-11_113_n2o.gcf  $scr/GCF
fi

module load foss/2023b

if [ 24 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < W4-11_113_n2o.inp > W4-11_113_n2o.out
	srun  /software/users/povpisim/DoNOFmpig.x < W4-11_113_n2o.inp > W4-11_113_n2o.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < W4-11_113_n2o.inp > W4-11_113_n2o.out
fi

out="/gscratch/povmieci/TMP/W4-11_113_n2o.1613093"

ls $out

 zip W4-11_113_n2o-out.zip W4-11_113_n2o.out

 mv -f W4-11_113_n2o.inp     $out/.
 mv -f W4-11_113_n2o-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/W4-11_113_n2o.gcf
 mv -f GCFe           $out/W4-11_113_n2o.gcfe
 mv -f WFN            $out/W4-11_113_n2o.wfn
 mv -f CGGRAD         $out/W4-11_113_n2o.cgo
 mv -f FCHK           $out/W4-11_113_n2o.fchk
 mv -f 1DM            $out/W4-11_113_n2o.1dm
 cat MLD XYZ >        $out/W4-11_113_n2o.mld

 rm -f BFST CGM W4-11_113_n2o.out

 ls 

 cd $out
 
###  cp -f W4-11_113_n2o.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_113_n2o.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_113_n2o.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_113_n2o.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_113_n2o.fchk $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_113_n2o.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f W4-11_113_n2o.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

