#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=4gb
#SBATCH --time=96:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=BH76_1_n2

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/BH76_1_n2.3930576/BH76_1_n2.inp $scr/.
cp /gscratch/povmieci/TMP/BH76_1_n2.3930576/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/BH76_1_n2.3930576/BH76_1_n2.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/BH76_1_n2.3930576/BH76_1_n2.gcf  $scr/."
cp /gscratch/povmieci/TMP/BH76_1_n2.3930576/BH76_1_n2.gcf  $scr/GCF
fi

module load foss/2023b

if [ 12 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < BH76_1_n2.inp > BH76_1_n2.out
	srun  /software/users/povpisim/DoNOFmpig.x < BH76_1_n2.inp > BH76_1_n2.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < BH76_1_n2.inp > BH76_1_n2.out
fi

out="/gscratch/povmieci/TMP/BH76_1_n2.3930576"

ls $out

 zip BH76_1_n2-out.zip BH76_1_n2.out

 mv -f BH76_1_n2.inp     $out/.
 mv -f BH76_1_n2-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/BH76_1_n2.gcf
 mv -f GCFe           $out/BH76_1_n2.gcfe
 mv -f WFN            $out/BH76_1_n2.wfn
 mv -f CGGRAD         $out/BH76_1_n2.cgo
 mv -f FCHK           $out/BH76_1_n2.fchk
 mv -f 1DM            $out/BH76_1_n2.1dm
 cat MLD XYZ >        $out/BH76_1_n2.mld

 rm -f BFST CGM BH76_1_n2.out

 ls 

 cd $out
 
###  cp -f BH76_1_n2.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2.fchk $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

