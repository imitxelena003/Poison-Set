#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=4gb
#SBATCH --time=96:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=BH76_1_oh

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/BH76_1_oh.3440132/BH76_1_oh.inp $scr/.
cp /gscratch/povmieci/TMP/BH76_1_oh.3440132/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/BH76_1_oh.3440132/BH76_1_oh.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/BH76_1_oh.3440132/BH76_1_oh.gcf  $scr/."
cp /gscratch/povmieci/TMP/BH76_1_oh.3440132/BH76_1_oh.gcf  $scr/GCF
fi

module load foss/2023b

if [ 12 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < BH76_1_oh.inp > BH76_1_oh.out
	srun  /software/users/povpisim/DoNOFmpig.x < BH76_1_oh.inp > BH76_1_oh.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < BH76_1_oh.inp > BH76_1_oh.out
fi

out="/gscratch/povmieci/TMP/BH76_1_oh.3440132"

ls $out

 zip BH76_1_oh-out.zip BH76_1_oh.out

 mv -f BH76_1_oh.inp     $out/.
 mv -f BH76_1_oh-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/BH76_1_oh.gcf
 mv -f GCFe           $out/BH76_1_oh.gcfe
 mv -f WFN            $out/BH76_1_oh.wfn
 mv -f CGGRAD         $out/BH76_1_oh.cgo
 mv -f FCHK           $out/BH76_1_oh.fchk
 mv -f 1DM            $out/BH76_1_oh.1dm
 cat MLD XYZ >        $out/BH76_1_oh.mld

 rm -f BFST CGM BH76_1_oh.out

 ls 

 cd $out
 
###  cp -f BH76_1_oh.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_oh.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_oh.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_oh.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_oh.fchk $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_oh.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_oh.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

