#!/bin/bash
#SBATCH --partition=p_fast
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1gb
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j

## Do not change below this line
####SBATCH --mem=7520mb

JOBNAME=G2RC_20_13

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID
mkdir $scr

cd $scr

cp /gscratch/povmieci/TMP/G2RC_20_13.1312614/G2RC_20_13.inp $scr/.
cp /gscratch/povmieci/TMP/G2RC_20_13.1312614/*bas $scr/.
if [ -f /gscratch/povmieci/TMP/G2RC_20_13.1312614/G2RC_20_13.gcf ]; then
echo " cp /gscratch/povmieci/TMP/G2RC_20_13.1312614/G2RC_20_13.gcf  $scr/."
cp /gscratch/povmieci/TMP/G2RC_20_13.1312614/G2RC_20_13.gcf  $scr/GCF
fi

#module load intel/2020a
#module load intel/2020a #  intel/2019b
module load foss/2023b
if [ 8 -gt "1" ]; then
echo "Running Parallel DoNOF"
# module load impi
mpirun  /software/users/povpisim/DoNOFmpig.x < G2RC_20_13.inp > G2RC_20_13.out
#srun  /software/users/povpisim/DoNOFmpi.x < G2RC_20_13.inp > G2RC_20_13.out
else
echo "Running Serial DoNOF"
# module load intel
/software/users/povpisim/DoNOF.x < G2RC_20_13.inp > G2RC_20_13.out
fi

#out="/gscratch/povmieci/TMP/G2RC_20_13.1312614/G2RC_20_13"."${SLURM_JOBID}"
#mkdir $out
out="/gscratch/povmieci/TMP/G2RC_20_13.1312614"
ls $out

 mv -f G2RC_20_13.inp $out/.
 mv -f G2RC_20_13.out $out/.
 mv -f GCF        $out/G2RC_20_13.gcf
 mv -f GCFe       $out/G2RC_20_13.gcfe
 mv -f WFN        $out/G2RC_20_13.wfn
 mv -f CGGRAD     $out/G2RC_20_13.cgo
 mv -f FCHK       $out/G2RC_20_13.fchk
 mv -f 1DM        $out/G2RC_20_13.1dm
 cat MLD XYZ >    $out/G2RC_20_13.mld
 
 ls
 cd $out
 
 cp -f G2RC_20_13.gcf  $SLURM_SUBMIT_DIR/.
 cp -f G2RC_20_13.gcfe $SLURM_SUBMIT_DIR/.
 cp -f G2RC_20_13.wfn  $SLURM_SUBMIT_DIR/.
 cp -f G2RC_20_13.cgo  $SLURM_SUBMIT_DIR/.
 cp -f G2RC_20_13.fchk $SLURM_SUBMIT_DIR/.
 cp -f G2RC_20_13.mld  $SLURM_SUBMIT_DIR/.
 cp -f G2RC_20_13.1dm  $SLURM_SUBMIT_DIR/.
       
 zip G2RC_20_13-out.zip G2RC_20_13.out
 mv -f G2RC_20_13-out.zip $SLURM_SUBMIT_DIR/.
 
 rm -rf $scr

