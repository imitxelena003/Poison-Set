#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=8gb
#SBATCH --time=96:00:00
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=22560mb

JOBNAME=BH76_1_n2ohts

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/BH76_1_n2ohts.1776546/BH76_1_n2ohts.inp $scr/.
cp /gscratch/povmieci/TMP/BH76_1_n2ohts.1776546/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/BH76_1_n2ohts.1776546/BH76_1_n2ohts.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/BH76_1_n2ohts.1776546/BH76_1_n2ohts.gcf  $scr/."
cp /gscratch/povmieci/TMP/BH76_1_n2ohts.1776546/BH76_1_n2ohts.gcf  $scr/GCF
fi

module load foss/2023b

if [ 24 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < BH76_1_n2ohts.inp > BH76_1_n2ohts.out
	srun  /software/users/povpisim/DoNOFmpig.x < BH76_1_n2ohts.inp > BH76_1_n2ohts.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < BH76_1_n2ohts.inp > BH76_1_n2ohts.out
fi

out="/gscratch/povmieci/TMP/BH76_1_n2ohts.1776546"

ls $out

 zip BH76_1_n2ohts-out.zip BH76_1_n2ohts.out

 mv -f BH76_1_n2ohts.inp     $out/.
 mv -f BH76_1_n2ohts-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/BH76_1_n2ohts.gcf
 mv -f GCFe           $out/BH76_1_n2ohts.gcfe
 mv -f WFN            $out/BH76_1_n2ohts.wfn
 mv -f CGGRAD         $out/BH76_1_n2ohts.cgo
 mv -f FCHK           $out/BH76_1_n2ohts.fchk
 mv -f 1DM            $out/BH76_1_n2ohts.1dm
 cat MLD XYZ >        $out/BH76_1_n2ohts.mld

 rm -f BFST CGM BH76_1_n2ohts.out

 ls 

 cd $out
 
###  cp -f BH76_1_n2ohts.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2ohts.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2ohts.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2ohts.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2ohts.fchk $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2ohts.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f BH76_1_n2ohts.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

