#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=8gb
#SBATCH --time=96:00:00
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j
#SBATCH --constraint=amd192

## Do not change below this line
####SBATCH --mem=22560mb

JOBNAME=G2RC_10_67-ri

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr
cp /gscratch/povmieci/TMP/G2RC_10_67-ri.3774743/G2RC_10_67-ri.inp $scr/.
cp /gscratch/povmieci/TMP/G2RC_10_67-ri.3774743/*.bas      $scr/.
if [ -f /gscratch/povmieci/TMP/G2RC_10_67-ri.3774743/G2RC_10_67-ri.gcf ]; then 
echo " cp /gscratch/povmieci/TMP/G2RC_10_67-ri.3774743/G2RC_10_67-ri.gcf  $scr/."
cp /gscratch/povmieci/TMP/G2RC_10_67-ri.3774743/G2RC_10_67-ri.gcf  $scr/GCF
fi

module load foss/2023b

if [ 24 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	# mpirun  /software/users/povpisim/DoNOFmpig.x < G2RC_10_67-ri.inp > G2RC_10_67-ri.out
	srun  /software/users/povpisim/DoNOFmpig.x < G2RC_10_67-ri.inp > G2RC_10_67-ri.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < G2RC_10_67-ri.inp > G2RC_10_67-ri.out
fi

out="/gscratch/povmieci/TMP/G2RC_10_67-ri.3774743"

ls $out

 zip G2RC_10_67-ri-out.zip G2RC_10_67-ri.out

 mv -f G2RC_10_67-ri.inp     $out/.
 mv -f G2RC_10_67-ri-out.zip $out/.
 mv -f *.bas          $out/.
 mv -f GCF            $out/G2RC_10_67-ri.gcf
 mv -f GCFe           $out/G2RC_10_67-ri.gcfe
 mv -f WFN            $out/G2RC_10_67-ri.wfn
 mv -f CGGRAD         $out/G2RC_10_67-ri.cgo
 mv -f FCHK           $out/G2RC_10_67-ri.fchk
 mv -f 1DM            $out/G2RC_10_67-ri.1dm
 cat MLD XYZ >        $out/G2RC_10_67-ri.mld

 rm -f BFST CGM G2RC_10_67-ri.out

 ls 

 cd $out
 
###  cp -f G2RC_10_67-ri.gcf  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67-ri.gcfe $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67-ri.wfn  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67-ri.cgo  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67-ri.fchk $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67-ri.1dm  $SLURM_SUBMIT_DIR/.
###  cp -f G2RC_10_67-ri.mld  $SLURM_SUBMIT_DIR/.
       
 rm -rf $scr

