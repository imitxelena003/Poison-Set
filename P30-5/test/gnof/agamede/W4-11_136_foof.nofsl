#!/bin/bash
#SBATCH --partition=p_slow
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=8gb
#SBATCH --time=96:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --output=%x.o%j
#SBATCH --error=%x.e%j

## Do not change below this line
####SBATCH --mem=11280mb

JOBNAME=W4-11_136_foof

HOST=agamede
echo Job runing on 

export scr=/gscratch/povmieci/SCRATCH/$SLURM_JOBID

mkdir $scr

cd $scr

cp /gscratch/povmieci/TMP/W4-11_136_foof.397990/W4-11_136_foof.inp $scr/.
cp /gscratch/povmieci/TMP/W4-11_136_foof.397990/*.bas  $scr/.
if [ -f /gscratch/povmieci/TMP/W4-11_136_foof.397990/W4-11_136_foof.gcf ]; then 
	echo " cp /gscratch/povmieci/TMP/W4-11_136_foof.397990/W4-11_136_foof.gcf  $scr/."
cp /gscratch/povmieci/TMP/W4-11_136_foof.397990/W4-11_136_foof.gcf  $scr/GCF
fi

module load foss/2023b

if [ 12 -gt "1" ]; then
	echo "Running Parallel DoNOF"
	# module load impi
	mpirun  /software/users/povpisim/DoNOFmpig.x < W4-11_136_foof.inp > W4-11_136_foof.out
	#srun  /software/users/povpisim/DoNOFmpi.x < W4-11_136_foof.inp > W4-11_136_foof.out
else
	echo "Running Serial DoNOF"
	# module load intel
	/software/users/povpisim/DoNOF.x < W4-11_136_foof.inp > W4-11_136_foof.out
fi

#out="/gscratch/povmieci/TMP/W4-11_136_foof.397990/W4-11_136_foof"."${SLURM_JOBID}"
#mkdir $out
out="/gscratch/povmieci/TMP/W4-11_136_foof.397990"
ls $out

 mv -f W4-11_136_foof.inp $out/.
 mv -f W4-11_136_foof.out $out/.
 mv -f GCF        $out/W4-11_136_foof.gcf
 mv -f GCFe       $out/W4-11_136_foof.gcfe
 mv -f WFN        $out/W4-11_136_foof.wfn
 mv -f CGGRAD     $out/W4-11_136_foof.cgo
 mv -f FCHK       $out/W4-11_136_foof.fchk
 mv -f 1DM        $out/W4-11_136_foof.1dm
 cat MLD XYZ >    $out/W4-11_136_foof.mld
 
 ls 
 cd $out
 
 cp -f W4-11_136_foof.gcf  $SLURM_SUBMIT_DIR/.
 cp -f W4-11_136_foof.gcfe $SLURM_SUBMIT_DIR/.
 cp -f W4-11_136_foof.wfn  $SLURM_SUBMIT_DIR/.
 cp -f W4-11_136_foof.cgo  $SLURM_SUBMIT_DIR/.
 cp -f W4-11_136_foof.fchk $SLURM_SUBMIT_DIR/.
 cp -f W4-11_136_foof.mld  $SLURM_SUBMIT_DIR/.
 cp -f W4-11_136_foof.1dm  $SLURM_SUBMIT_DIR/.
       
 zip W4-11_136_foof-out.zip W4-11_136_foof.out 
 mv -f W4-11_136_foof-out.zip $SLURM_SUBMIT_DIR/.
 
 rm -rf $scr

